    "@tanstack/react-query": "^5.51.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^7.1.0",
    "urql": "^4.2.0"
  },
